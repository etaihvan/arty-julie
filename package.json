{
  "name": "arty-julie-website",
  "version": "1.0.0",
  "description": "Website for Arty Julie (Julie V's Art Classes): kids, teen and adult art classes and holiday art camps.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && tsx scripts/prerender.ts",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --port 4173",
    "check:links": "tsx scripts/check-links.ts",
    "images": "node scripts/optimize-images.mjs"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "lucide-react": "^1.57.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^6.4.4"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
